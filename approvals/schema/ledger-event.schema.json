{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://market-sense.local/approvals/schema/ledger-event.schema.json",
  "title": "ApprovalLedgerEvent（审批账本单事件 · 存储态 v0.1）",
  "description": "append-only 审批账本的一行。与 contracts/approval/openapi.yaml#/components/schemas/ApprovalEvent 对齐并附加存储态字段（seq / prev_event_hash / event_hash）；API 响应投影时剔除后三个字段。未生效：仅结构草案，不被任何服务加载。",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "seq", "prev_event_hash", "event_hash", "approval_ref", "type", "at", "actor"],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "全局唯一；由建单事务生成，撤回/驳回/过期后不得复用（L51/R9）。"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "description": "单笔审批内自 1 连续递增、无洞；连续性是账本完整性校验的一部分。"
    },
    "prev_event_hash": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "上一条事件的 event_hash；seq=1 时必须为 null。哈希链用于发现篡改/删除（H5 基线「审计不可篡改」）。"
    },
    "event_hash": {
      "$ref": "#/$defs/Sha256",
      "description": "本事件规范化哈希：键名字典序的 JSON（排除 event_hash 自身）UTF-8 后 sha256，前缀 sha256:。"
    },
    "approval_ref": {
      "$ref": "#/$defs/ApprovalRef"
    },
    "type": {
      "type": "string",
      "enum": ["created", "evaluated", "routed", "auto_passed", "approved", "rejected", "expired", "cancelled"],
      "description": "契约 ApprovalEvent.type 为 created/evaluated/routed/auto_passed/approved/rejected/expired；cancelled 为账本扩展（契约缺，缺口 G-04）。"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "$ref": "#/$defs/Actor",
      "description": "事件来源。approved/rejected 只能 human；auto_passed 只能 rule_engine；agent 必须带 model_version。"
    },
    "evaluation": {
      "$ref": "#/$defs/Evaluation"
    },
    "decision": {
      "$ref": "#/$defs/Decision"
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "人类可读说明：撤回/过期原因、驳回摘要、更正指向等。"
    }
  },
  "allOf": [
    {
      "$comment": "seq=1 无前驱哈希",
      "if": {
        "properties": { "seq": { "const": 1 } },
        "required": ["seq"]
      },
      "then": {
        "properties": { "prev_event_hash": { "type": "null" } }
      },
      "else": {
        "properties": { "prev_event_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
      }
    },
    {
      "$comment": "evaluated 必带评估结果；黄档必填 route_to",
      "if": {
        "properties": { "type": { "const": "evaluated" } },
        "required": ["type"]
      },
      "then": {
        "required": ["evaluation"]
      }
    },
    {
      "$comment": "auto_passed 只能由确定性规则引擎产生，且 decision 恒为 green_auto_pass",
      "if": {
        "properties": { "type": { "const": "auto_passed" } },
        "required": ["type"]
      },
      "then": {
        "required": ["evaluation"],
        "properties": {
          "actor": { "$ref": "#/$defs/RuleEngineActor" },
          "evaluation": { "$ref": "#/$defs/GreenEvaluation" }
        }
      }
    },
    {
      "$comment": "人类决定：decided_by 必须是人类，reason ≥8",
      "if": {
        "properties": { "type": { "enum": ["approved", "rejected"] } },
        "required": ["type"]
      },
      "then": {
        "required": ["decision"],
        "properties": {
          "actor": { "$ref": "#/$defs/HumanActor" },
          "decision": { "$ref": "#/$defs/HumanDecision" }
        }
      }
    },
    {
      "$comment": "撤回/过期必须写明原因",
      "if": {
        "properties": { "type": { "enum": ["expired", "cancelled"] } },
        "required": ["type"]
      },
      "then": {
        "required": ["note"]
      }
    }
  ],
  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ApprovalRef": {
      "type": "string",
      "description": "L51：apr_<uuidv7>，跨环境可带 prod:/staging: 前缀（与 services/identity/src/domain/approval-ref.ts:26 的 APPROVAL_REF_PATTERN 同源）。",
      "pattern": "^(?:(?:prod|staging):)?apr_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "Actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["human", "agent", "rule_engine"],
          "description": "契约 Actor.kind 仅 human|agent；rule_engine 为账本扩展（绿档决定者不能是 LLM agent，R6，缺口 G-07）。"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "model_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "agent 必填（H5「模型版本绑定」）；human/rule_engine 不填。"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "agent 必填：执行轮次/会话来源，仅存储态留痕，不进契约响应。"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "agent" } }, "required": ["kind"] },
          "then": { "required": ["model_version", "run_id"] }
        },
        {
          "if": { "properties": { "kind": { "const": "rule_engine" } }, "required": ["kind"] },
          "then": {
            "properties": { "id": { "pattern": "^rule_engine:" } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "human" } }, "required": ["kind"] },
          "then": { "not": { "required": ["model_version"] } }
        }
      ]
    },
    "HumanActor": {
      "allOf": [{ "$ref": "#/$defs/Actor" }],
      "properties": { "kind": { "const": "human" } }
    },
    "RuleEngineActor": {
      "allOf": [{ "$ref": "#/$defs/Actor" }],
      "properties": { "kind": { "const": "rule_engine" } }
    },
    "PolicySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "Evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "rule_id", "rule_version", "source_refs", "policy_snapshot", "input_hash", "reason_codes", "evaluated_at"],
      "properties": {
        "decision": { "type": "string", "enum": ["green_auto_pass", "yellow_route", "red_block"] },
        "rule_id": { "type": "string", "minLength": 1 },
        "rule_version": { "type": "string", "minLength": 1 },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "policy_snapshot": { "$ref": "#/$defs/PolicySnapshot" },
        "input_hash": { "$ref": "#/$defs/Sha256" },
        "reason_codes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "route_to": { "type": "string", "minLength": 1 },
        "required_reviews": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "evaluated_at": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "$comment": "黄档必须给出路由席位",
          "if": { "properties": { "decision": { "const": "yellow_route" } }, "required": ["decision"] },
          "then": { "required": ["route_to"] }
        }
      ]
    },
    "GreenEvaluation": {
      "allOf": [{ "$ref": "#/$defs/Evaluation" }],
      "properties": { "decision": { "const": "green_auto_pass" } }
    },
    "Decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_ref", "decision", "decided_by", "decided_at", "reason"],
      "properties": {
        "approval_ref": { "$ref": "#/$defs/ApprovalRef" },
        "decision": { "type": "string", "enum": ["approved", "rejected"] },
        "decided_by": { "$ref": "#/$defs/Actor" },
        "decided_at": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "minLength": 8, "maxLength": 500 }
      }
    },
    "HumanDecision": {
      "allOf": [{ "$ref": "#/$defs/Decision" }],
      "properties": { "decided_by": { "$ref": "#/$defs/HumanActor" } }
    }
  }
}
