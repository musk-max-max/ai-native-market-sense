{
  "name": "market-sense-h5",
  "version": "0.0.0",
  "private": true,
  "description": "market-sense-h5 · AI-native A 股 market sense H5（单仓 pnpm workspace，决策 #2）",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "lint": "eslint infra eslint.config.mjs",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "node infra/ci/typecheck.mjs",
    "test": "node --test infra/ci/test/*.test.mjs && pnpm -r --if-present test",
    "ci:detect": "node infra/ci/has.mjs --gha all",
    "ci:registry": "node infra/ci/path-guard.mjs --validate-registry",
    "ci:path-guard": "node infra/ci/path-guard.mjs",
    "ci:path-guard:selftest": "node infra/ci/path-guard.mjs --self-test",
    "ci:contracts": "node infra/ci/contract-diff.mjs",
    "ci:runbooks": "node infra/ci/check-runbooks.mjs",
    "ci:all": "node infra/ci/check-all.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.13.0",
    "@redocly/cli": "1.34.23",
    "eslint": "9.13.0",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.11.0"
  }
}
