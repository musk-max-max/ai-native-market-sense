# 主机基线期望（fail-closed 目标态，非当前态）。
# 由 infra/drift/host-baseline-audit.sh 读取；改动需 A13 提 PR，H5 评审。
# A19 L91 复核（370c6bb）+ A9 R7 复核：ECS 主机态（SG/ufw/sshd/非 compose 容器）在仓库零 IaC 表达。

# 允许监听在通配地址的 TCP 端口（空格分隔）。sshd 是唯一合法公网入口例外。
EXPECTED_WILDCARD_LISTEN_PORTS="22"

# 公网安全组/ufw 曾放行的端口（L91 后应为空；保留历史高危端口用于持续检查）
EXPECTED_PUBLIC_PORTS="80 8888"
# 公网入口 host；为空 = 未配置，脚本显式 UNVERIFIED（不得当 PASS）。L91 内网裁定后通常为空。
EXPECTED_PUBLIC_HOST=""

# 允许 0.0.0.0/:: 端口绑定的容器名（空格分隔）。业务容器一律只允许 127.0.0.1。
EXPECTED_PUBLIC_CONTAINERS=""

# ufw 允许入站的端口/范围（空格分隔，按 ufw status 的 "To" 列，允许 "80/tcp" 或 "39000:40000/tcp"）。
EXPECTED_UFW_ALLOW="22/tcp"

# 告警出口（可选）：HOST-EXPOSURE-01 命中时 POST JSON；未配置则只输出 ALERT 行到 stdout。
# ALERT_WEBHOOK_URL=""
# 每日 textfile 指标输出目录（可选，配合 node_exporter textfile collector 与 HostExposureDrift 告警）
# HOST_BASELINE_TEXTFILE_DIR=/var/lib/node_exporter/textfile_collector

# 22 端口允许的来源 CIDR（空格分隔）。为空 = 尚无用户白名单，脚本报 FAIL（不得默认 Anywhere 通过）。
# 用户给出 CIDR 后：先 `ufw allow from <CIDR> to any port 22`，再把 CIDR 填到这里并重跑 after 证据；
# 填了之后 「22 Anywhere」 规则删除前仍应 FAIL（来源未受限），不要只改期望值来造绿。
EXPECTED_SSH_ALLOWED_FROM=""

# fail2ban 必须 active 且 sshd jail 存在（A19 R2 / gate ⑤）。
EXPECTED_FAIL2BAN_ACTIVE="1"

# sshd 目标配置（sshd -T 键值）
EXPECTED_SSHD_PERMITROOTLOGIN="no"
EXPECTED_SSHD_PASSWORD_AUTHENTICATION="no"
EXPECTED_SSHD_MAXAUTHTRIES="3"

# 运行中业务容器的授权 env 期望（A3 KD-ENT-01：e2e 栈也必须显式 1/1，不能靠默认关）
EXPECTED_ENTITLEMENT_AUDIT="1"
EXPECTED_ENTITLEMENT_HOLD_CHECK="1"
