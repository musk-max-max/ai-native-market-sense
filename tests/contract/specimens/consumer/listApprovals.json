{
  "operation_id": "listApprovals",
  "client": "内部审批后台（approval）",
  "calls": [
    {
      "name": "审批单列表",
      "request": {
        "method": "GET",
        "path": "/v1/internal/approvals",
        "query": {
          "status": "submitted",
          "limit": 20
        },
        "headers": {
          "authorization": "Bearer synthetic-internal-token"
        }
      },
      "expect": {
        "status": 200,
        "required_fields": [
          "items[].approval_ref",
          "items[].status"
        ]
      }
    }
  ]
}
