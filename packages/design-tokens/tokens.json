{
  "$meta": {
    "name": "@market-sense/design-tokens",
    "version": "2.0.0",
    "description": "market-sense-h5 设计 token 单一真值。唯一直接读源，禁止在 app.css / 组件里手写色值。",
    "source": "docs/design/system-v2.md §2–§6 + design/token-integration.md §2–§6",
    "wcag": "2.1 AA",
    "minBodyContrast": 4.5,
    "minNonTextContrast": 3.0,
    "generates": [
      "dist/tokens.css",
      "dist/antd-theme.mjs",
      "dist/adm-tokens.css"
    ],
    "consumerContract": "未签发项见 README『签发状态』；AI 标识/免责视觉规格待 H3 签发。"
  },

  "primitive": {
    "blue-500": "#1677ff",
    "blue-600": "#0f5fd6",
    "blue-700": "#5b8cff",
    "red-500": "#d92b20",
    "red-600": "#e63e31",
    "red-700": "#c5302b",
    "red-800": "#a12622",
    "red-900": "#c5302b",
    "green-500": "#00804a",
    "green-600": "#00a854",
    "green-700": "#00794a",
    "green-800": "#1c6b3d",
    "amber-700": "#7a4d00",
    "amber-600": "#b45309",
    "gray-900": "#1f2329",
    "gray-600": "#5c6370",
    "gray-500": "#6b7280",
    "gray-400": "#9aa3ad",
    "gray-300": "#aab6c4",
    "gray-200": "#d7dde5",
    "gray-150": "#eef1f5",
    "gray-100": "#e8f1ff",
    "white": "#ffffff"
  },

  "semantic": {
    "text": {
      "value": { "light": "{primitive.gray-900}", "dark": "#e7eaee" },
      "role": "主正文、标题",
      "contrast": { "against": ["surface", "bg"], "min": 4.5, "kind": "text" }
    },
    "text-muted": {
      "value": { "light": "{primitive.gray-600}", "dark": "{primitive.gray-400}" },
      "role": "次要说明、口径、来源、as_of 标签",
      "contrast": { "against": ["surface", "bg"], "min": 4.5, "kind": "text", "note": "压 surface-2 5.34 仅临界不达标，避免用于 surface-2 正文" }
    },
    "text-subtle": {
      "value": { "light": "{primitive.gray-500}", "dark": "#8a93a0" },
      "role": "仅 ≥13px 辅助行，且仅白底",
      "contrast": { "against": ["surface"], "min": 4.5, "kind": "text", "note": "压 bg 4.46 / surface-2 4.27 不达标，禁用于非白底" }
    },
    "text-disabled": {
      "value": { "light": "{primitive.gray-400}", "dark": "{primitive.gray-600}" },
      "role": "仅禁用态",
      "contrast": { "against": [], "min": 0, "kind": "disabled", "note": "WCAG 1.4.3 豁免；免责/AI 标识/as_of 永不用此 token" }
    },

    "bg": {
      "value": { "light": "#f4f6f8", "dark": "#0b0f14" },
      "role": "页面底"
    },
    "surface": {
      "value": { "light": "{primitive.white}", "dark": "#131a22" },
      "role": "卡片底"
    },
    "surface-2": {
      "value": { "light": "{primitive.gray-150}", "dark": "#1b2430" },
      "role": "缺口卡/分组底/表头底"
    },

    "border": {
      "value": { "light": "{primitive.gray-200}", "dark": "#2a3542" },
      "role": "仅装饰性分隔",
      "contrast": { "against": [], "min": 0, "kind": "non-text", "note": "1.37/白，不作控件边界" }
    },
    "border-strong": {
      "value": { "light": "{primitive.gray-300}", "dark": "#465463" },
      "role": "hover/选中描边（非文本）",
      "contrast": { "against": [], "min": 0, "kind": "non-text" }
    },
    "border-control": {
      "value": { "light": "#8a929c", "dark": "#8a929c" },
      "role": "输入框/可交互控件边界",
      "contrast": { "against": ["surface"], "min": 3.0, "kind": "non-text", "note": "WCAG 1.4.11；antd 默认 #d9d9d9 不达标，必须覆盖。深色档另用 #a3abb5（见 darkOverride）" },
      "darkOverride": "#a3abb5"
    },

    "brand": {
      "value": { "light": "{primitive.blue-500}", "dark": "{primitive.blue-700}" },
      "role": "选中条/图标/焦点装饰（非文本 3:1）",
      "contrast": { "against": ["surface"], "min": 3.0, "kind": "non-text", "note": "白字压它仅 4.10，禁作正文/链接文字" }
    },
    "brand-strong": {
      "value": { "light": "{primitive.blue-600}", "dark": "{primitive.blue-700}" },
      "role": "链接文字/主按钮底/TabBar 选中文字",
      "contrast": { "against": ["surface", "bg"], "min": 4.5, "kind": "text", "note": "压 brand-weak 仅 light 5.09 达标；深色档 3.55 不达标，深色选中底上文字另走 --ms-brand" }
    },
    "brand-weak": {
      "value": { "light": "{primitive.gray-100}", "dark": "#10233f" },
      "role": "选中行底/激活 Tab 底/选中段底",
      "contrast": { "against": [], "min": 0, "kind": "background", "note": "其上文字只能用 brand-strong" }
    },
    "brand-contrast": {
      "value": { "light": "{primitive.white}", "dark": "{primitive.white}" },
      "role": "主按钮文字（压 brand-strong 5.79）",
      "contrast": { "against": ["brand-strong"], "min": 4.5, "kind": "text" }
    },
    "brand-emphasis": {
      "value": { "light": "{primitive.red-600}", "dark": "#ff8b82" },
      "role": "东财红，品牌强调位（首页顶部指数涨/TabBar 激活点）+ AI 方标底",
      "contrast": { "against": ["surface"], "min": 3.0, "kind": "non-text", "note": "作按钮底白字仅 4.12，仅 ≥18.66px bold；禁用于机会/推荐语义" }
    },

    "up": {
      "value": { "light": "{primitive.red-500}", "dark": "#ff8b82" },
      "role": "涨：正文数值/涨跌幅（始终落在白卡 surface 上）",
      "contrast": { "against": ["surface"], "min": 4.5, "kind": "text", "note": "压 bg #f4f6f8 仅 4.49，禁直接压页面底；行情数值均在白卡内" }
    },
    "up-strong": {
      "value": { "light": "{primitive.red-600}", "dark": "#ff8b82" },
      "role": "涨：≥24px 大号价格（东财红）",
      "contrast": { "against": ["surface"], "min": 3.0, "kind": "large-text-only", "note": "4.12/白，正文禁用" }
    },
    "up-weak": {
      "value": { "light": "#fdecea", "dark": "#3a1c1a" },
      "role": "涨胶囊底",
      "contrast": { "against": [], "min": 0, "kind": "background", "note": "其上文字只能用 up-weak-text" }
    },
    "up-weak-text": {
      "value": { "light": "{primitive.red-700}", "dark": "#ffc9c4" },
      "role": "涨胶囊文字唯一可用色",
      "contrast": { "against": ["up-weak"], "min": 4.5, "kind": "text" }
    },

    "down": {
      "value": { "light": "{primitive.green-500}", "dark": "#3ddc97" },
      "role": "跌：正文数值/涨跌幅",
      "contrast": { "against": ["surface", "bg"], "min": 4.5, "kind": "text" }
    },
    "down-strong": {
      "value": { "light": "{primitive.green-600}", "dark": "#3ddc97" },
      "role": "跌：≥24px 大号价格",
      "contrast": { "against": ["surface"], "min": 3.0, "kind": "large-text-only", "note": "3.12/白正文不达标；压 down-weak 2.79 任何字号禁用" }
    },
    "down-weak": {
      "value": { "light": "#e6f6ec", "dark": "#102e20" },
      "role": "跌胶囊底",
      "contrast": { "against": [], "min": 0, "kind": "background" }
    },
    "down-weak-text": {
      "value": { "light": "{primitive.green-700}", "dark": "#b8f0d0" },
      "role": "跌胶囊文字唯一可用色",
      "contrast": { "against": ["down-weak", "surface"], "min": 4.5, "kind": "text" }
    },

    "flat": {
      "value": { "light": "{primitive.gray-600}", "dark": "{primitive.gray-400}" },
      "role": "平盘/中性/muted",
      "contrast": { "against": ["surface", "bg"], "min": 4.5, "kind": "text", "note": "压 surface-2 5.34 仅临界不达标" }
    },

    "warning-text": {
      "value": { "light": "{primitive.amber-700}", "dark": "#ffd693" },
      "role": "合规锁定说明/警示文字",
      "contrast": { "against": ["warning-bg", "surface"], "min": 4.5, "kind": "text" }
    },
    "warning-bg": {
      "value": { "light": "#fff7e6", "dark": "#33240c" },
      "role": "警示底/锁定项行底",
      "contrast": { "against": [], "min": 0, "kind": "background" }
    },
    "warning-border": {
      "value": { "light": "{primitive.amber-600}", "dark": "#d9a13b" },
      "role": "警示边框（非文本）",
      "contrast": { "against": [], "min": 0, "kind": "non-text" }
    },

    "danger-text": {
      "value": { "light": "{primitive.red-800}", "dark": "#ffb4ae" },
      "role": "错误/危险确认标题/回滚；antd colorError",
      "contrast": { "against": ["danger-bg", "surface"], "min": 4.5, "kind": "text", "note": "语义=失败/危险，不是涨" }
    },
    "danger-bg": {
      "value": { "light": "#fdecec", "dark": "#351717" },
      "role": "错误底",
      "contrast": { "against": [], "min": 0, "kind": "background" }
    },
    "danger-border": {
      "value": { "light": "{primitive.red-500}", "dark": "#ff8b82" },
      "role": "ghost-danger 按钮边框（非文本）",
      "contrast": { "against": [], "min": 0, "kind": "non-text" }
    },

    "success-text": {
      "value": { "light": "{primitive.green-800}", "dark": "#7ee2a8" },
      "role": "发布成功等状态文字",
      "contrast": { "against": ["success-bg", "surface"], "min": 4.5, "kind": "text" }
    },
    "success-bg": {
      "value": { "light": "#eaf7ef", "dark": "#1c3326" },
      "role": "成功底",
      "contrast": { "against": [], "min": 0, "kind": "background" }
    },

    "focus": {
      "value": { "light": "{primitive.blue-600}", "dark": "{primitive.blue-700}" },
      "role": "键盘焦点环（2px，与底色 3:1）",
      "contrast": { "against": ["surface", "bg"], "min": 3.0, "kind": "non-text" }
    }
  },

  "aiContent": {
    "_doc": "AI 生成内容标识与不可关闭免责样式。承载 H3 政策 rules/ai-content-policy.json 的视觉硬约束：≥13px、≥4.5:1、无关闭、无折叠、无 opacity<1。数值口径由 M1 定，文案与放行由 H3 签发。",
    "sign-off": "待 H3 签发（视觉规格数值口径 M1 已定，文案与 C 端放行未签）",
    "ai-badge-bg": {
      "value": { "light": "{semantic.brand-emphasis.value.light}", "dark": "{semantic.brand-emphasis.value.dark}" },
      "role": "方形 AI 标底（白字）",
      "contrast": { "against": [], "min": 3.0, "kind": "non-text" }
    },
    "ai-badge-contrast": {
      "value": { "light": "{primitive.white}", "dark": "{primitive.white}" },
      "role": "方形 AI 标文字（≥3:1 压 ai-badge-bg；图形用途）",
      "contrast": { "against": ["ai-badge-bg"], "min": 3.0, "kind": "non-text" }
    },
    "ai-label-text": {
      "value": { "light": "{primitive.gray-600}", "dark": "{primitive.gray-400}" },
      "role": "『AI 生成 · 仅供参考』文字，禁用 text-disabled",
      "contrast": { "against": ["surface", "bg", "surface-2"], "min": 4.5, "kind": "text" }
    },
    "disclaimer-text": {
      "value": { "light": "{primitive.gray-600}", "dark": "{primitive.gray-400}" },
      "role": "免责声明正文，字号下限 caption；不可折叠/不可关闭/无透明度",
      "contrast": { "against": ["surface", "bg", "surface-2"], "min": 4.5, "kind": "text" }
    },
    "as-of-text": {
      "value": { "light": "{primitive.gray-600}", "dark": "{primitive.gray-400}" },
      "role": "as_of 时间戳文字，字号下限 caption，一等公民不可弱化",
      "contrast": { "against": ["surface", "bg", "surface-2"], "min": 4.5, "kind": "text" }
    },
    "complianceMinFontSize": { "h5": "13px", "console": "12px" }
  },

  "typography": {
    "font-sans": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif",
    "font-mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace",
    "font-numeric": "'DIN Alternate', 'Helvetica Neue', -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif",
    "size": {
      "display": { "h5": "28px", "console": "24px", "weight": "bold" },
      "title": { "h5": "18px", "console": "16px", "weight": "semibold" },
      "body": { "h5": "15px", "console": "14px", "weight": "regular" },
      "body-compact": { "h5": "14px", "console": "13px", "weight": "regular" },
      "caption": { "h5": "13px", "console": "12px", "weight": "regular", "note": "免责/as_of/来源下限，不得再小" },
      "tag": { "h5": "11px", "console": "11px", "weight": "medium", "note": "仅标签/Badge 短语，禁承载合规文案" }
    },
    "numeric": "tabular-nums"
  },

  "spacing": {
    "_base": "8pt 基准，4pt 半档",
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-5": "24px",
    "space-6": "32px",
    "h5": { "page-gutter": "16px", "card-gap": "12px", "card-padding": "16px", "tabbar-height": "50px", "navbar-height": "44px", "max-width": "640px" },
    "console": { "sidebar": "232px", "topbar": "56px", "table-row-height": "44px", "grid-columns": 24, "grid-gutter": "16px" }
  },

  "radius": {
    "lg": { "h5": "14px", "console": "8px" },
    "sm": { "h5": "10px", "console": "4px" },
    "pill": "999px",
    "control": "6px"
  },

  "shadow": {
    "_doc": "阴影不是对比度要素；克制原则：分隔线优先于阴影，卡片无阴影或仅一档。",
    "card": {
      "light": "0 1px 2px rgb(16 24 40 / 6%), 0 2px 8px rgb(16 24 40 / 6%)",
      "dark": "0 1px 2px rgb(0 0 0 / 35%), 0 2px 10px rgb(0 0 0 / 30%)"
    }
  },

  "motion": {
    "_doc": "只做状态反馈，不做注意力劫持。禁涨跌闪烁循环/脉冲/老虎机/方向性弹跳。",
    "duration-fast": "120ms",
    "duration-base": "200ms",
    "duration-mid": "240ms",
    "duration-slow": "320ms",
    "easing-standard": "cubic-bezier(0.4, 0, 0.2, 1)",
    "easing-emphasized": "cubic-bezier(0.2, 0, 0, 1)",
    "quote-flash": { "duration": "240ms", "repeat": "once", "note": "数字滚动+颜色淡入，strong→base 200ms 后回退，一次性" },
    "modal-mask": { "duration": "240ms", "bounce": false },
    "card-enter": { "stagger": false, "note": "禁 stagger 入场" }
  },

  "component": {
    "antd": {
      "colorPrimary": "{semantic.brand-strong.value.light}",
      "colorLink": "{semantic.brand-strong.value.light}",
      "colorError": "{semantic.danger-text.value.light}",
      "colorWarning": "{primitive.amber-600}",
      "colorSuccess": "{semantic.success-text.value.light}",
      "colorInfo": "{semantic.brand-strong.value.light}",
      "colorTextBase": "{semantic.text.value.light}",
      "colorBgBase": "{primitive.white}",
      "colorBgLayout": "{semantic.bg.value.light}",
      "colorBgContainer": "{primitive.white}",
      "colorText": "{semantic.text.value.light}",
      "colorTextSecondary": "{semantic.text-muted.value.light}",
      "colorTextTertiary": "{semantic.text-muted.value.light}",
      "colorTextQuaternary": "{semantic.text-disabled.value.light}",
      "colorBorder": "{semantic.border.value.light}",
      "colorBorderSecondary": "{semantic.surface-2.value.light}",
      "borderRadius": 8,
      "borderRadiusLG": 8,
      "borderRadiusSM": 4,
      "fontSize": 14,
      "controlHeight": 32,
      "wireframe": false,
      "motionDurationMid": "0.24s",
      "motionDurationFast": "0.12s",
      "_inputBorder": "{semantic.border-control.value.light}",
      "_note": "色值仅 light 基准；darkTheme 由生成器按 dark 列另出（见 dist/antd-theme.mjs）。"
    },
    "adm": {
      "color-primary": "{semantic.brand-strong.value.light}",
      "color-success": "{semantic.success-text.value.light}",
      "color-warning": "{primitive.amber-600}",
      "color-danger": "{semantic.danger-text.value.light}",
      "color-text": "{semantic.text.value.light}",
      "color-text-secondary": "{semantic.text-muted.value.light}",
      "color-weak": "{semantic.text-muted.value.light}",
      "color-light": "{semantic.border-strong.value.light}",
      "color-border": "{semantic.border.value.light}",
      "color-background": "{semantic.surface.value.light}",
      "color-box": "{semantic.bg.value.light}",
      "radius-s": "6px",
      "radius-m": "10px",
      "radius-l": "14px",
      "font-family": "{typography.font-sans}",
      "font-size-main": "15px",
      "font-size-1": "11px",
      "font-size-2": "12px",
      "font-size-3": "13px",
      "font-size-4": "14px",
      "font-size-5": "15px",
      "font-size-6": "16px",
      "font-size-7": "18px",
      "_note": "antd-mobile 5.43 无 ConfigProvider theme，--adm-* CSS 变量是唯一主题方式。"
    }
  },

  "legacyAlias": {
    "_doc": "旧名 → 新名，生成进 dist/tokens.css，让 token 切换零 JSX/CSS 改动落地。下一轮删别名前 grep 必须为 0。",
    "brand-deep": "{semantic.brand-strong}",
    "accent": "{semantic.brand-strong}",
    "accent-weak": "{semantic.brand-weak}",
    "accent-contrast": "{semantic.brand-contrast}",
    "bg": "{semantic.bg}",
    "surface": "{semantic.surface}",
    "surface-2": "{semantic.surface-2}",
    "text": "{semantic.text}",
    "text-muted": "{semantic.text-muted}",
    "text-subtle": "{semantic.text-subtle}",
    "border": "{semantic.border}",
    "border-strong": "{semantic.border-strong}",
    "up": "{semantic.up}",
    "up-strong": "{semantic.up-strong}",
    "up-weak": "{semantic.up-weak}",
    "down": "{semantic.down}",
    "down-strong": "{semantic.down-strong}",
    "down-weak": "{semantic.down-weak}",
    "warning-bg": "{semantic.warning-bg}",
    "warning-border": "{semantic.warning-border}",
    "warning-text": "{semantic.warning-text}",
    "danger-bg": "{semantic.danger-bg}",
    "danger-border": "{semantic.danger-border}",
    "danger-text": "{semantic.danger-text}",
    "focus": "{semantic.focus}",
    "shadow": "{shadow.card}",
    "radius": "{radius.lg}",
    "radius-sm": "{radius.sm}",
    "radius-pill": "{radius.pill}",
    "font-sans": "{typography.font-sans}",
    "font-mono": "{typography.font-mono}",
    "max-width": "{spacing.h5.max-width}"
  }
}