{
  "name": "@market-sense/h5",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "market-sense-h5 · C 端 H5（P0 个股页竖切片）。owner: A7。",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/copy-snapshot.mjs --check && vite build && node scripts/check-bundle-compliance.mjs",
    "preview": "vite preview",
    "start": "node server.mjs",
    "typecheck": "tsc --noEmit",
    "check:budget": "node scripts/check-budget.mjs",
    "check:testids": "node scripts/check-testids.mjs",
    "check:sources": "node --test test/source-labels.test.ts",
    "check:compliance": "node --test test/compliance.test.ts",
    "check:copy": "node scripts/copy-snapshot.mjs --check",
    "check:bundle": "node scripts/check-bundle-compliance.mjs",
    "check:dom": "node scripts/check-dom-compliance.mjs",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@market-sense/api-client": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
