  "blocker_blocks_downstream": true,
  "scoring": {
    "mode": "blocker_only",
    "warn_affects_score": false,
    "decision_ref": "L9",
    "note": "质量分只由 blocker 计分；分子按规则去重（同一规则多条违规算 1），warn 不进分子但计入该类规则总数；warn 条数单列 violation_counts，避免为变绿而调阈值",
    "score_counts": "blocker_rules",
    "numerator": "distinct_blocker_rules_hit_in_category",
    "denominator": "rules_in_category",
    "formula": "category_score = 100 * (1 - distinct_blocker_rules_hit_in_category / total_rules_in_category)"
  },
